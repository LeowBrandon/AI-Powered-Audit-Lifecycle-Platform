# AuditIQ MVP Backend Configuration
# By default AuditIQ uses local SQLite (auditiq.db) and works fully offline
# using its deterministic rules + local NLP reasoning engine.

# Optional: switch to PostgreSQL for enterprise / Docker deployment
# DATABASE_URL=postgresql+psycopg2://auditiq:auditiq@localhost:5432/auditiq

# Optional: enable external OpenAI-compatible LLM augmentation for Auditor Copilot & Reasoning
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=*
